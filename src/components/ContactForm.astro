---
---
<form class="cform" method="post" action="/api/contact" data-contact>
  <div class="row2">
    <label>Име*<input name="name" required maxlength="120" autocomplete="name" /></label>
    <label>Имейл*<input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
  </div>
  <div class="row2">
    <label>Телефон<input name="phone" maxlength="40" autocomplete="tel" /></label>
    <label>Тема<input name="subject" maxlength="200" /></label>
  </div>
  <label>Съобщение*<textarea name="message" required rows="6" maxlength="5000"></textarea></label>
  <label class="hp" aria-hidden="true">Не попълвайте<input name="website" tabindex="-1" autocomplete="off" /></label>
  <label class="consent"><input type="checkbox" name="consent" required /> <span>Съгласен/на съм данните ми да бъдат обработени съгласно <a href="/privacy-policy/">Политиката за поверителност</a>.</span></label>
  <button class="btn" type="submit">Изпрати</button>
  <p class="cform-msg" role="status" aria-live="polite"></p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-contact]').forEach((f) => {
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = f.querySelector('.cform-msg')!;
      const btn = f.querySelector('button')!;
      btn.disabled = true; msg.textContent = 'Изпращане…'; msg.className = 'cform-msg';
      try {
        const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.error || 'Грешка');
        f.reset(); msg.textContent = 'Благодарим! Съобщението е изпратено. Ще се свържем с Вас скоро.'; msg.classList.add('ok');
      } catch (err) {
        msg.textContent = 'Съобщението не можа да бъде изпратено. Моля, пишете ни директно на имейл.'; msg.classList.add('err');
      } finally { btn.disabled = false; }
    });
  });
</script>
