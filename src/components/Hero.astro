---
import { accent, md } from '../lib/util';
const { hero } = Astro.props;
const isImage = hero.style === 'image' && hero.image;
---
{isImage ? (
  <section class="hero-img">
    <div class="wrap hero-img-in">
      <div class="hero-left">
        {hero.label && <div class="label">{hero.label}</div>}
        <h1 set:html={accent(hero.title)} />
        {hero.text && <div class="hero-text" set:html={md(hero.text)} />}
        {hero.buttons && <div class="btns">{hero.buttons.map((b) => <a class={b.outline ? 'btn ghost-dark' : 'btn'} href={b.link}>{b.text}</a>)}</div>}
        {hero.stats && (
          <dl class="hero-stats">{hero.stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl>
        )}
      </div>
      <figure class="hero-figure">
        <img src={hero.image} alt="" fetchpriority="high" />
        <span class="hero-orb hero-orb-l" aria-hidden="true"></span>
        <span class="hero-orb hero-orb-r" aria-hidden="true"></span>
      </figure>
    </div>
    {hero.links && (
      <div class="hero-links-band">
        <div class="wrap hero-links">
          {hero.links.map((l, i) => (
            <a href={l.link} class="entry">
              <span class="entry-num">{String(i + 1).padStart(2, '0')}</span>
              <strong>{l.title}</strong>
              <span class="entry-text">{l.text}</span>
              <i aria-hidden="true">→</i>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
) : (
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-head">
        {hero.watermark && <div class="watermark" aria-hidden="true">{hero.watermark}</div>}
        {hero.label && <div class="label">{hero.label}</div>}
        <h1 set:html={accent(hero.title)} />
        {hero.subtitle && <p class="subtitle">{hero.subtitle}</p>}
      </div>
      {(hero.text || hero.buttons) && (
        <div class="hero-body">
          {hero.text && <div class="lead" set:html={md(hero.text)} />}
          {hero.buttons && <div class="btns">{hero.buttons.map((b) => <a class={b.outline ? 'btn ghost-dark' : 'btn'} href={b.link}>{b.text}</a>)}</div>}
        </div>
      )}
    </div>
  </section>
)}
