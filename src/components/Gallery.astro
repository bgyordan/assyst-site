---
// Снимки към новина или събитие. Кликване отваря снимката на цял екран.
const { photos = [] } = Astro.props as { photos?: string[] };
const list = photos.filter(Boolean);
---
{list.length > 0 && (
  <section class="gallery wrap narrow" aria-label="Снимки">
    <div class={`gallery-grid n${Math.min(list.length, 4)}`}>
      {list.map((src, i) => (
        <a href={src} class="gallery-item" data-i={i} aria-label={`Снимка ${i + 1} от ${list.length}`}>
          <img src={src} alt="" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
    <dialog class="lightbox" aria-label="Снимка">
      <img alt="" />
      <button type="button" class="lb-close" aria-label="Затвори">✕</button>
      <button type="button" class="lb-prev" aria-label="Предишна">‹</button>
      <button type="button" class="lb-next" aria-label="Следваща">›</button>
      <span class="lb-count"></span>
    </dialog>
  </section>
)}
<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((g) => {
    const items = [...g.querySelectorAll<HTMLAnchorElement>('.gallery-item')];
    const dlg = g.querySelector('dialog')!; const img = dlg.querySelector('img')!; const cnt = dlg.querySelector('.lb-count')!;
    let i = 0;
    const show = (n: number) => { i = (n + items.length) % items.length; img.src = items[i].href; cnt.textContent = `${i + 1} / ${items.length}`; };
    items.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); show(n); dlg.showModal(); }));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
    let x = 0; dlg.addEventListener('touchstart', (e) => { x = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const d = e.changedTouches[0].clientX - x; if (Math.abs(d) > 50) show(d < 0 ? i + 1 : i - 1); });
    if (items.length < 2) dlg.querySelectorAll('.lb-prev,.lb-next,.lb-count').forEach((b) => b.remove());
  });
</script>
