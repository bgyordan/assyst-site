{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assyst-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin/pro/config.yml"]
  },
  // Contact form e-mail. Sent from forma.assyst.bg (Email Routing is enabled only on that
  // subdomain, so the main assyst.bg mail stays at SuperHosting) to the verified CONTACT_TO.
  "send_email": [{ "name": "MAIL", "destination_address": "assystbulgaria@gmail.com" }],
  // Admin panel editors and sessions. Wrangler creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "USERS" }],
  "vars": {
    "CONTACT_TO": "assystbulgaria@gmail.com",
    "CONTACT_FROM": "sait@forma.assyst.bg",
    "REPO": "bgyordan/assyst-site"
  }
  // Secrets (set in the Cloudflare dashboard, never committed):
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET  – GitHub OAuth app for /admin
}
